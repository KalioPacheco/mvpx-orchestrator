{
  "name": "mvpx-orchestrator",
  "version": "0.4.13",
  "description": "Cost-aware autonomous orchestration for Codex with bounded planning, adaptive model routing, resumable execution, deterministic validation, and fresh targeted repairs.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "codex",
    "ai-agents",
    "agent-orchestration",
    "coding-agent",
    "typescript",
    "cli",
    "developer-tools",
    "llm"
  ],
  "homepage": "https://github.com/KalioPacheco/mvpx-orchestrator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KalioPacheco/mvpx-orchestrator.git"
  },
  "bugs": {
    "url": "https://github.com/KalioPacheco/mvpx-orchestrator/issues"
  },
  "type": "module",
  "bin": {
    "mvpx": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "selftest:validation": "npm run build && node --test tests/validation-router.test.mjs",
    "selftest:repairs": "npm run build && node --test tests/fresh-repairs.test.mjs",
    "selftest": "npm run selftest:validation && node --test tests/fresh-repairs.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.156.1",
    "commander": "^15.0.0",
    "execa": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
